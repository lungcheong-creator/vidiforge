# Sample environment for VidiForge API

# === REQUIRED ===
# Random bearer token for the API (generate with: openssl rand -hex 32)
VIDIFORGE_API_TOKEN=changeme-replace-with-openssl-rand-hex-32

# Fernet master key for at-rest encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VIDIFORGE_MASTER_KEY=changeme-replace-with-fernet-key

# === OPTIONAL ===
# Environment mode (development|production)
VIDIFORGE_ENV=development

# Frontend origin for CORS
WEB_ORIGIN=http://localhost:3000

# Active LLM provider (openai|anthropic|deepseek|gemini|moonshot|openai_compatible)
LLM_PROVIDER=openai

# Direct API keys (server-side fallback; BYOK via Settings takes precedence)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Storage paths (relative to /app by default)
STORAGE_OUTPUT_DIR=storage/outputs
STORAGE_CACHE_DIR=storage/cache
STORAGE_UPLOAD_DIR=storage/upload

# Database
DATABASE_URL=sqlite:///./storage/vidiforge.db

# Server
HOST=0.0.0.0
PORT=8080